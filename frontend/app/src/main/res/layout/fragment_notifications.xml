<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F0F4FF">

    <!-- Naslov + test dugme -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="24dp"
        android:paddingBottom="4dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Obavještenja"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#1A237E"
            android:paddingStart="16dp"/>

        <Button
            android:id="@+id/btnMarkAllRead"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Sve pročitano"
            android:textSize="11sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#1565C0"
            android:layout_marginEnd="12dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"/>

    </LinearLayout>

    <!-- Tabovi po tipu (horizontalno skrolabilni) -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="4dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnTabSve"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Sve"
                android:textSize="12sp"
                android:layout_marginEnd="6dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"/>

            <Button
                android:id="@+id/btnTabChat"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Čet"
                android:textSize="12sp"
                android:layout_marginEnd="6dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"/>

            <Button
                android:id="@+id/btnTabRanking"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Rang"
                android:textSize="12sp"
                android:layout_marginEnd="6dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"/>

            <Button
                android:id="@+id/btnTabRewards"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Nagrade"
                android:textSize="12sp"
                android:layout_marginEnd="6dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"/>

            <Button
                android:id="@+id/btnTabOther"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Ostalo"
                android:textSize="12sp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"/>

        </LinearLayout>
    </HorizontalScrollView>

    <!-- Filter pročitano/nepročitano -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="12dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Prikaži: "
            android:textSize="12sp"
            android:textColor="#555555"
            android:layout_marginEnd="4dp"/>

        <Button
            android:id="@+id/btnFilterAll"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:text="Sve"
            android:textSize="11sp"
            android:layout_marginEnd="4dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"/>

        <Button
            android:id="@+id/btnFilterUnread"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:text="Nepročitane"
            android:textSize="11sp"
            android:layout_marginEnd="4dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"/>

        <Button
            android:id="@+id/btnFilterRead"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:text="Pročitane"
            android:textSize="11sp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"/>

    </LinearLayout>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#C5CAE9"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="4dp"/>

    <!-- Lista notifikacija -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_view_notifications"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingTop="4dp"
        android:paddingBottom="16dp"/>

    <!-- Prazno stanje -->
    <TextView
        android:id="@+id/empty_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="Nema obavještenja"
        android:textSize="16sp"
        android:textColor="#9E9E9E"
        android:visibility="gone"/>

</LinearLayout>
