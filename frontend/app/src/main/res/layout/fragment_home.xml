<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <include
        android:id="@+id/headerStats"
        layout="@layout/layout_player_header" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Dobrodošli u Slagalicu!"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="@color/text"
            android:layout_marginBottom="30dp" />

        <Button
            android:id="@+id/btnStartGame"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:text="⚡ ZAPOČNI MEČ (KREĆE KVIZ)"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/text"
            android:backgroundTint="@color/primary"
            android:layout_marginBottom="40dp" />

        <Button
            android:id="@+id/btnRegionMap"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="🗺  Mapa regiona"
            android:textColor="@color/text"
            android:backgroundTint="#1E3A5F" />

        <Button
            android:id="@+id/btnFriends"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="👥  Prijatelji"
            android:textColor="@color/text"
            android:backgroundTint="#1E3A5F" />

        <Button
            android:id="@+id/btnLeaderboard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="🏆  Rang lista"
            android:textColor="@color/text"
            android:backgroundTint="#1E3A5F" />

        <Button
            android:id="@+id/btnDailyMissions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="📋  Dnevne misije"
            android:textColor="@color/text"
            android:backgroundTint="#1E3A5F" />

        <Button
            android:id="@+id/btnRegionalChallenges"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⚔  Regionalni izazovi"
            android:backgroundTint="#FF5722"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btnRegionalChat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="💬  Regionalni čet"
            android:textColor="@color/text"
            android:backgroundTint="#1E3A5F" />

    </LinearLayout>

    <ImageButton
        android:id="@+id/btnNotifications"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="100dp"
        android:layout_marginEnd="12dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@android:drawable/ic_popup_reminder"
        app:tint="#FFFFFF"
        android:contentDescription="Notifikacije" />

    <ImageButton
        android:id="@+id/btnProfile"
        android:layout_width="54dp"
        android:layout_height="54dp"
        android:layout_gravity="top|start"
        android:layout_marginTop="100dp"
        android:layout_marginStart="16dp"
        android:src="@drawable/ic_avatar_placeholder"
        android:contentDescription="Avatar korisnika"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:scaleType="centerInside" />

</FrameLayout>