<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <include
        android:id="@+id/headerStats"
        layout="@layout/layout_player_header" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Dobrodošli u Slagalicu!"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/text" />

        <Button
            android:id="@+id/btnIgrajOnline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Igraj online"
            android:textColor="@color/text"
            android:backgroundTint="@color/primary" />

        <Button
            android:id="@+id/btnKorakPoKorak"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Igra: Korak po korak"
            android:textColor="@color/text"
            android:backgroundTint="@color/primary"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnMojBroj"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Igra: Moj broj"
            android:textColor="@color/text"
            android:backgroundTint="@color/primary"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnAsocijacija"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Igra: Asocijacija"
            android:textColor="@color/text"
            android:backgroundTint="@color/primary" />

        <Button
            android:id="@+id/btnSkocko"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Igra: Skočko"
            android:textColor="@color/text"
            android:backgroundTint="@color/primary" />

        <Button
            android:id="@+id/btnKoZnaZna"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Igra: Ko zna zna"
            android:textColor="@color/text"
            android:backgroundTint="@color/primary" />

        <Button
            android:id="@+id/btnSpojnice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Igra: Spojnice"
            android:textColor="@color/text"
            android:backgroundTint="@color/primary" />

    </LinearLayout>

    <ImageButton
        android:id="@+id/btnNotifications"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="100dp"
        android:layout_marginEnd="12dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@android:drawable/ic_popup_reminder"
        app:tint="#FFFFFF"
        android:contentDescription="Notifikacije" />


    <ImageButton
        android:id="@+id/btnProfile"
        android:layout_width="54dp"
        android:layout_height="54dp"
        android:layout_gravity="top|start"
        android:layout_marginTop="100dp"
        android:layout_marginStart="16dp"
        android:src="@drawable/ic_avatar_placeholder"
        android:contentDescription="Avatar korisnika"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:scaleType="centerInside" />


</FrameLayout>

