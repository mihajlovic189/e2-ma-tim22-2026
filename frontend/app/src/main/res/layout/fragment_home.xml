<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Dobrodošli u Slagalicu!"
            android:textSize="24sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnGoToReset"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="Promeni Lozinku" />

        <Button
            android:id="@+id/btnKorakPoKorak"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Igra: Korak po korak"
            android:backgroundTint="#4CAF50" />

        <Button
            android:id="@+id/btnMojBroj"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Igra: Moj broj"
            android:backgroundTint="#FF9800" />

        <Button
            android:id="@+id/btnAsocijacija"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Igra: Asocijacija"
            android:backgroundTint="#2196F3" />

        <Button
            android:id="@+id/btnSkocko"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Igra: Skočko"
            android:backgroundTint="#9C27B0" />

    </LinearLayout>

    <ImageButton
        android:id="@+id/btnNotifications"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="30dp"
        android:layout_marginEnd="12dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@android:drawable/ic_popup_reminder"
        android:tint="#FFFFFF"
        android:contentDescription="Notifikacije" />
</FrameLayout>