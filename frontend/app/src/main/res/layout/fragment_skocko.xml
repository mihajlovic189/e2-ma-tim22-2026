                android:layout_weight="1"
                android:background="@drawable/button_background"
                android:backgroundTint="#E3F2FD"
                android:scaleType="centerInside" />

            <include
                android:id="@+id/fb1"
                layout="@layout/item_skocko_feedback"
                android:visibility="invisible" />

