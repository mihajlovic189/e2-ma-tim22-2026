<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:padding="24dp">

    <include
        android:id="@+id/gameStatus"
        layout="@layout/layout_game_score_timer" />

    <TextView
        android:id="@+id/tvTargetNumber"
        android:layout_width="100dp"
        android:layout_height="58dp"
        android:layout_marginTop="100dp"
        android:background="@drawable/input_bg"
        android:backgroundTint="#1E293B"
        android:gravity="center"
        android:text="@string/placeholder_three"
        android:textColor="@color/primary"
        android:textSize="36sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/numbersContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:orientation="horizontal"
        android:gravity="center"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvTargetNumber">

        <TextView style="@style/StepStyle" android:layout_width="45dp" android:layout_height="45dp" android:layout_margin="2dp" android:text="\?" android:textSize="16sp" android:textColor="@color/primary" android:padding="0dp"/>
        <TextView style="@style/StepStyle" android:layout_width="45dp" android:layout_height="45dp" android:layout_margin="2dp" android:text="\?" android:textSize="16sp" android:textColor="@color/primary" android:padding="0dp"/>
        <TextView style="@style/StepStyle" android:layout_width="45dp" android:layout_height="45dp" android:layout_margin="2dp" android:text="\?" android:textSize="16sp" android:textColor="@color/primary" android:padding="0dp"/>
        <TextView style="@style/StepStyle" android:layout_width="45dp" android:layout_height="45dp" android:layout_margin="2dp" android:text="\?" android:textSize="16sp" android:textColor="@color/primary" android:padding="0dp"/>
        <TextView style="@style/StepStyle" android:layout_width="55dp" android:layout_height="45dp" android:layout_margin="2dp" android:text="\??" android:textSize="16sp" android:textColor="@color/primary" android:padding="0dp"/>
        <TextView style="@style/StepStyle" android:layout_width="65dp" android:layout_height="45dp" android:layout_margin="2dp" android:text="\?\??" android:textSize="16sp" android:textColor="@color/primary" android:padding="0dp"/>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/expressionContainer"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/numbersContainer">

        <TextView
            android:id="@+id/tvExpression"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/input_bg"
            android:gravity="center_vertical"
            android:hint="Vaš izraz..."
            android:paddingStart="16dp"
            android:paddingEnd="50dp"
            android:textColor="@color/text"
            android:textColorHint="@color/hint"
            android:textSize="20sp" />

        <ImageButton
            android:id="@+id/btnDelete"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_input_delete"
            app:tint="@color/hint" />
    </FrameLayout>

    <GridLayout
        android:id="@+id/operandsGrid"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:columnCount="3"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/expressionContainer">

        <Button
            style="@style/OperandBtn"
            android:text="+"
            android:textSize="32sp"
            android:gravity="center"
            android:includeFontPadding="false" />

        <Button
            style="@style/OperandBtn"
            android:text="-"
            android:textSize="28sp"
            android:gravity="center" />

        <Button
            style="@style/OperandBtn"
            android:text="*"
            android:textSize="28sp"
            android:gravity="center" />

        <Button
            style="@style/OperandBtn"
            android:text="/"
            android:textSize="28sp"
            android:gravity="center" />

        <Button
            style="@style/OperandBtn"
            android:text="("
            android:textSize="28sp"
            android:gravity="center" />

        <Button
            style="@style/OperandBtn"
            android:text=")"
            android:textSize="28sp"
            android:gravity="center" />

    </GridLayout>

    <Button
        android:id="@+id/btnSubmit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="40dp"
        android:text="POTVRDI UNOS"
        android:visibility="gone"
        android:textColor="@color/text"
        android:backgroundTint="@color/primary"
        app:layout_constraintBottom_toBottomOf="parent" />

    <Button
        android:id="@+id/btnStop"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="40dp"
        android:text="STOP / SHAKE"
        android:textColor="@color/text"
        android:backgroundTint="@color/primary"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>