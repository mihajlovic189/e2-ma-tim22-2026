<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@color/challenge_bg">

    <TextView
        android:id="@+id/tvRegionTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/active_challenges_label"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@color/challenge_text_dark"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btnCreateChallenge"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/btn_create_challenge"
        android:backgroundTint="@color/btn_create_orange"
        android:textColor="@android:color/white"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/active_challenges_label"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvChallenges"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>