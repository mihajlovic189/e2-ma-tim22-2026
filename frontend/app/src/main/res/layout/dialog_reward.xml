<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Confetti particles are added here at runtime by RewardDialogHelper -->
    <FrameLayout
        android:id="@+id/confettiContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false" />

    <com.google.android.material.card.MaterialCardView
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        app:cardBackgroundColor="@color/button_bg"
        app:cardCornerRadius="20dp"
        app:cardElevation="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:padding="24dp">

            <ImageView
                android:id="@+id/ivRewardIcon"
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:src="@drawable/ic_trophy"
                android:contentDescription="@string/profile_league_icon" />

            <TextView
                android:id="@+id/tvRewardTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textColor="@color/text"
                android:textSize="20sp"
                android:textStyle="bold"
                android:gravity="center"
                tools:text="Nagrada za plasman!" />

            <TextView
                android:id="@+id/tvRewardBody"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="@color/hint"
                android:textSize="15sp"
                android:gravity="center"
                tools:text="Osvojili ste 1. mesto na nedeljnoj rang listi! Dobili ste 5 tokena!" />

            <Button
                android:id="@+id/btnRewardClose"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:backgroundTint="@color/primary"
                android:textColor="@color/text"
                android:text="Super! 🎊" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</FrameLayout>
