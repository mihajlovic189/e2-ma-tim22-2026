rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      // Publicly readable — needed for:
      //   • registration (username-taken check runs before auth is created)
      //   • leaderboard, friend search (reads other users' documents)
      allow read: if true;
      // Only the authenticated owner may write their own document
      allow write: if request.auth != null && request.auth.uid == userId;

      match /friends/{friendId} {
        // Only the list owner can read their own friends
        allow read: if request.auth != null && request.auth.uid == userId;
        // Owner can manage their list; the other user writes their mirrored entry
        // (bidirectional add without Cloud Functions)
        allow write: if request.auth != null &&
                        (request.auth.uid == userId || request.auth.uid == friendId);
      }
    }

    match /region_stats/{regionId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    match /ko_zna_zna_results/{resultId} {
      allow create: if request.auth != null;
      allow read:   if request.auth != null;
      allow update, delete: if false;
    }

    match /spojnice_results/{resultId} {
      allow create: if request.auth != null;
      allow read:   if request.auth != null;
      allow update, delete: if false;
    }

    match /asocijacije_results/{resultId} {
      allow create: if request.auth != null;
      allow read:   if request.auth != null;
      allow update, delete: if false;
    }

    match /skocko_results/{resultId} {
      allow create: if request.auth != null;
      allow read:   if request.auth != null;
      allow update, delete: if false;
    }

    match /korak_po_korak_results/{resultId} {
      allow create: if request.auth != null;
      allow read:   if request.auth != null;
      allow update, delete: if false;
    }

    match /moj_broj_results/{resultId} {
      allow create: if request.auth != null;
      allow read:   if request.auth != null;
      allow update, delete: if false;
    }

    match /slagalica_match_results/{resultId} {
      allow create: if request.auth != null;
      allow read:   if request.auth != null;
      allow update, delete: if false;
    }

    match /users/{userId}/notifications/{notifId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      // Any authenticated user may create a notification for another user (friend-added, etc.)
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && request.auth.uid == userId;
    }
  }
}
